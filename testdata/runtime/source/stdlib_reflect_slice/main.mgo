package main

import "reflect"

type Pair struct {
	Name string
	Values [2]int
}

func Main() int {
	pairs := []Pair{{Name: "first", Values: [2]int{1, 2}}, {Name: "second", Values: [2]int{3, 4}}}
	reflect.Swapper(pairs)(0, 1)
	if pairs[0].Name != "second" || pairs[0].Values[1] != 4 || pairs[1].Name != "first" || pairs[1].Values[0] != 1 {
		return -3
	}
	x := []int{20, 2}
	old := x
	v := reflect.ValueOf(&x).Elem()
	v.Grow(3)
	if cap(x) < 5 { return -1 }
	view := v.Slice3(1, 2, 3)
	view.Index(0).SetInt(42)
	if old[1] != 2 { return -2 }
	return x[1]
}
