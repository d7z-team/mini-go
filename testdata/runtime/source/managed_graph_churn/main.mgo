package main

type Node struct {
	Value int
	Next *Node
	Data []int
	Meta map[string]int
}

func buildGraph() *Node {
	tail := &Node{Value: 2, Data: []int{3, 4}, Meta: map[string]int{"tail": 1}}
	return &Node{Value: 1, Next: tail, Data: []int{5, 6}, Meta: map[string]int{"head": 1}}
}

func Main() int {
	root := buildGraph()
	total := 0
	for i := 0; i < 8; i++ {
		scratch := make([]int, 3)
		scratch[0] = i
		scratch[1] = root.Value
		scratch[2] = root.Next.Value
		scratch = append(scratch, i + 1)
		table := map[string]int{"iteration": i}
		table["scratch"] = scratch[0] + scratch[3]
		root.Data[0]++
		root.Meta["last"] = i
		root.Next.Meta["last"] = table["scratch"]
		total += scratch[3] + table["scratch"]
	}
	if root.Data[0] != 13 || root.Meta["last"] != 7 || root.Next.Meta["last"] != 15 {
		return -1
	}
	if total != 100 {
		return -2
	}
	return 42
}
