package main

import "runtime/oracle/helper"

type Tag string

func Main() int {
	s := Tag(string([]byte{255, 0, 128}))
	b := []byte(string(s))
	var c byte = 42
	var bad uint64 = 18446744073709551615
	if string(c) != "*" || string(bad) != "�" || string(int32(-1)) != "�" {
		return -1
	}
	if b[0] != 255 || b[1] != 0 || b[2] != 128 {
		return -2
	}
	const raw = "\xff\x00\x80"
	var named Tag = raw
	var boxed any = raw
	if named != s || boxed.(string) != string(s) {
		return -3
	}
	joined := raw + "尾"
	if len(joined) != 6 || joined[0] != 255 || len([]rune(raw)) != 3 {
		return -4
	}
	if helper.Raw != raw || helper.Named != helper.Label(raw) {
		return -5
	}
	return 42
}
