{
  "name": "@d7z-team/mini-go",
  "version": "0.0.0-dev",
  "description": "Mini-Go TypeScript runtime and Go compiler for browsers and Node.js",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-Go",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": "./dist/node/index.js",
      "default": "./dist/browser/index.js"
    },
    "./rpc": {
      "types": "./dist/types/rpc.d.ts",
      "node": "./dist/node/rpc.js",
      "default": "./dist/browser/rpc.js"
    },
    "./tools": {
      "types": "./dist/types/tools.d.ts",
      "node": "./dist/node/tools.js",
      "default": "./dist/browser/tools.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.ts",
    "typecheck": "tsc && tsc -p tsconfig.tools.json",
    "format": "prettier --write src scripts tests benchmarks *.ts *.json",
    "lint": "npm run typecheck && node scripts/check-boundaries.ts && prettier --check src scripts tests benchmarks *.ts *.json && prettier --debug-check ../../testdata/rpc/generated/typescript/*.ts",
    "test": "vitest run",
    "test:node": "vitest run tests/runtime.node.test.js",
    "test:browser": "vitest run tests/runtime.browser.test.js",
    "test:package": "vitest run tests/package.test.js",
    "benchmark": "vitest bench --run --reporter=verbose --silent=false"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "rolldown": "1.2.14",
    "rolldown-plugin-dts": "0.28.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d7z-team/mini-go",
    "directory": "playground/runtime-typescript"
  },
  "bugs": {
    "url": "https://github.com/d7z-team/mini-go/issues"
  },
  "homepage": "https://github.com/d7z-team/mini-go/tree/main/playground/runtime-typescript",
  "publishConfig": {
    "access": "public"
  }
}
