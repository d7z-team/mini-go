{
  "name": "@d7z-team/mini-go",
  "version": "0.0.0-dev",
  "description": "Mini-Go TypeScript runtime and Go compiler for browsers and Node.js",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-Go",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.browser.d.ts",
      "node": "./dist/index.node.js",
      "default": "./dist/index.browser.js"
    },
    "./rpc": {
      "types": "./dist/rpc.browser.d.ts",
      "node": "./dist/rpc.node.js",
      "default": "./dist/rpc.browser.js"
    },
    "./tools": {
      "types": "./dist/tools.browser.d.ts",
      "node": "./dist/tools.node.js",
      "default": "./dist/tools.browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.bindings.json --noEmit",
    "format": "prettier --write src scripts tests *.json",
    "lint": "npm run typecheck && prettier --check src scripts tests *.json && prettier --debug-check ../../testdata/rpc/generated/typescript/*.ts",
    "pretest": "tsc -p tsconfig.bindings.json",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:node": "node --test tests/runtime.node.test.js",
    "test:browser": "node --test tests/runtime.browser.test.js",
    "test:package": "node --test tests/package.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d7z-team/mini-go",
    "directory": "playground/runtime-typescript"
  },
  "bugs": {
    "url": "https://github.com/d7z-team/mini-go/issues"
  },
  "homepage": "https://github.com/d7z-team/mini-go/tree/main/playground/runtime-typescript",
  "publishConfig": {
    "access": "public"
  }
}
