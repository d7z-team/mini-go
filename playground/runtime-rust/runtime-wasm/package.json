{
  "name": "@d7z-team/mini-go",
  "version": "0.0.0-dev",
  "description": "Mini-Go WebAssembly runtime for browsers and Node.js",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-Go",
    "README.md"
  ],
  "types": "./dist/browser.d.ts",
  "exports": {
    "./rpc": {
      "types": "./dist/browser-rpc.d.ts",
      "node": "./dist/node-rpc.js",
      "default": "./dist/browser-rpc.js"
    },
    "./tools": {
      "types": "./dist/browser-tools.d.ts",
      "node": "./dist/node-tools.js",
      "default": "./dist/browser-tools.js"
    },
    ".": {
      "types": "./dist/browser.d.ts",
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./worker": "./dist/browser-worker.js",
    "./rpc-worker": {
      "node": "./dist/node-rpc-worker.js",
      "default": "./dist/browser-rpc-worker.js"
    },
    "./wasm": "./dist/wasm/mini_go_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json && tsc -p tsconfig.bindings.json",
    "format": "prettier --write sdk scripts tests *.json",
    "lint": "npm run typecheck && prettier --check sdk scripts tests *.json && prettier --debug-check ../../../testdata/rpc/generated/typescript/*.ts",
    "prepack": "npm run build",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:node": "node --test tests/node.test.js",
    "test:browser": "node --test tests/browser.test.js",
    "test:package": "node --test tests/package.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d7z-team/go-mini",
    "directory": "playground/runtime-rust/runtime-wasm"
  },
  "bugs": {
    "url": "https://github.com/d7z-team/go-mini/issues"
  },
  "homepage": "https://github.com/d7z-team/go-mini/tree/main/playground/runtime-rust/runtime-wasm",
  "publishConfig": {
    "access": "public"
  }
}
