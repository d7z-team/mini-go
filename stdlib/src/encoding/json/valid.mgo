package json

func scanJSONValue(text string, pos int) (int, bool) {
	scan := newScanner()
	for i := pos; i < len(text); i++ {
		scan.bytes++
		opcode := scan.step(scan, text[i])
		if opcode == scanEnd {
			return i, true
		}
		if opcode == scanError {
			return i, false
		}
		if (opcode == scanEndObject || opcode == scanEndArray) && scan.endTop {
			return i + 1, true
		}
	}
	return len(text), scan.eof() != scanError
}

func scanJSONLiteral(text string, pos int, literal string) (int, bool) {
	if pos + len(literal) > len(text) {
		return pos, false
	}
	if text[pos:pos + len(literal)] != literal {
		return pos, false
	}
	return pos + len(literal), true
}

func scanJSONNumber(text string, pos int) (int, bool) {
	if pos >= len(text) || (text[pos] != '-' && (text[pos] < '0' || text[pos] > '9')) {
		return pos, false
	}
	return scanJSONValue(text, pos)
}

func skipJSONSpace(text string, pos int) int {
	for pos < len(text) {
		ch := text[pos:pos + 1]
		if ch != " " && ch != "\n" && ch != "\r" && ch != "\t" {
			break
		}
		pos++
	}
	return pos
}

func isJSONDigit(ch string) bool {
	return ch >= "0" && ch <= "9"
}
