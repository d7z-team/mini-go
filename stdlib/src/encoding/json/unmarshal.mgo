package json

import "encoding/base64"
import "encoding"
import "errors"
import "reflect"
import "strconv"
import "strings"
import "unicode/utf8"

type decodeOptions struct {
	firstError *error
	useNumber bool
	disallowUnknownFields bool
	fields map[reflect.Type][]jsonStructField
}

// Unmarshal parses the JSON-encoded data and stores the result
// in the value pointed to by v. If v is nil or not a pointer,
// Unmarshal returns an [InvalidUnmarshalError].
//
// Unmarshal uses the inverse of the encodings that
// [Marshal] uses, allocating maps, slices, and pointers as necessary,
// with the following additional rules:
//
// To unmarshal JSON into a pointer, Unmarshal first handles the case of
// the JSON being the JSON literal null. In that case, Unmarshal sets
// the pointer to nil. Otherwise, Unmarshal unmarshals the JSON into
// the value pointed at by the pointer. If the pointer is nil, Unmarshal
// allocates a new value for it to point to.
//
// To unmarshal JSON into a value implementing [Unmarshaler],
// Unmarshal calls that value's [Unmarshaler.UnmarshalJSON] method, including
// when the input is a JSON null.
// Otherwise, if the value implements [encoding.TextUnmarshaler]
// and the input is a JSON quoted string, Unmarshal calls
// [encoding.TextUnmarshaler.UnmarshalText] with the unquoted form of the string.
//
// To unmarshal JSON into a struct, Unmarshal matches incoming object keys to
// the keys used by [Marshal] (either the struct field name or its tag),
// ignoring case. If multiple struct fields match an object key, an exact case
// match is preferred over a case-insensitive one.
//
// Incoming object members are processed in the order observed. If an object
// includes duplicate keys, later duplicates will replace or be merged into
// prior values.
//
// To unmarshal JSON into an interface value,
// Unmarshal stores one of these in the interface value:
//
//   - bool, for JSON booleans
//   - float64, for JSON numbers
//   - string, for JSON strings
//   - []any, for JSON arrays
//   - map[string]any, for JSON objects
//   - nil for JSON null
//
// To unmarshal a JSON array into a slice, Unmarshal resets the slice length
// to zero and then appends each element to the slice.
// As a special case, to unmarshal an empty JSON array into a slice,
// Unmarshal replaces the slice with a new empty slice.
//
// To unmarshal a JSON array into a Go array, Unmarshal decodes
// JSON array elements into corresponding Go array elements.
// If the Go array is smaller than the JSON array,
// the additional JSON array elements are discarded.
// If the JSON array is smaller than the Go array,
// the additional Go array elements are set to zero values.
//
// To unmarshal a JSON object into a map, Unmarshal first establishes a map to
// use. If the map is nil, Unmarshal allocates a new map. Otherwise Unmarshal
// reuses the existing map, keeping existing entries. Unmarshal then stores
// key-value pairs from the JSON object into the map. The map's key type must
// either be any string type, an integer, or implement [encoding.TextUnmarshaler].
//
// If the JSON-encoded data contain a syntax error, Unmarshal returns a [SyntaxError].
//
// If a JSON value is not appropriate for a given target type,
// or if a JSON number overflows the target type, Unmarshal
// skips that field and completes the unmarshaling as best it can.
// If no more serious errors are encountered, Unmarshal returns
// an [UnmarshalTypeError] describing the earliest such error. In any
// case, it's not guaranteed that all the remaining fields following
// the problematic one will be unmarshaled into the target object.
//
// The JSON null value unmarshals into an interface, map, pointer, or slice
// by setting that Go value to nil. Because null is often used in JSON to mean
// “not present,” unmarshaling a JSON null into any other Go type has no effect
// on the value and produces no error.
//
// When unmarshaling quoted strings, invalid UTF-8 or
// invalid UTF-16 surrogate pairs are not treated as an error.
// Instead, they are replaced by the Unicode replacement
// character U+FFFD.
func Unmarshal(data []byte, value any) error {
	return unmarshal(data, value, decodeOptions{})
}

func unmarshal(data []byte, value any, options decodeOptions) error {
	if err := checkValid(data, newScanner()); err != nil {
		return err
	}
	text := string(data)
	end, err := unmarshalAt(text, skipJSONSpace(text, 0), value, options)
	if err != nil {
		return err
	}
	if skipJSONSpace(text, end) != len(text) {
		return newMarshalError("json: invalid trailing data")
	}
	return nil
}

func unmarshalAt(text string, pos int, value any, options decodeOptions) (int, error) {
	target := reflect.ValueOf(value)
	if !target.IsValid() || target.Kind() != reflect.Pointer || target.IsNil() {
		return pos, &InvalidUnmarshalError{Type: reflect.TypeOf(value)}
	}
	var firstError error
	options.firstError = &firstError
	options.fields = map[reflect.Type][]jsonStructField{}
	end, err := unmarshalValue(text, pos, target.Elem(), options)
	if err != nil {
		return end, err
	}
	return end, firstError
}

func unmarshalValue(text string, pos int, target reflect.Value, options decodeOptions) (next int, resultErr error) {
	defer func() {
		if resultErr != nil {
			if _, ok := resultErr.(*UnmarshalTypeError); ok && options.firstError != nil {
				if *options.firstError == nil {
					*options.firstError = resultErr
				}
				next, _ = scanJSONValue(text, skipJSONSpace(text, pos))
				resultErr = nil
			}
		}
	}()
	pos = skipJSONSpace(text, pos)
	if pos >= len(text) {
		return pos, newMarshalError("json: unexpected end of input")
	}
	if target.CanAddr() && target.Addr().CanInterface() {
		if unmarshaler, ok := target.Addr().Interface().(Unmarshaler); ok {
			end, valid := scanJSONValue(text, pos)
			if !valid {
				return pos, newMarshalError("json: invalid value")
			}
			return end, unmarshaler.UnmarshalJSON([]byte(text[pos:end]))
		}
		if textUnmarshaler, ok := target.Addr().Interface().(encoding.TextUnmarshaler); ok && text[pos:pos + 1] == "\"" {
			decoded, end, ok := parseJSONStringValue(text, pos)
			if !ok {
				return pos, newMarshalError("json: expected string")
			}
			return end, textUnmarshaler.UnmarshalText([]byte(decoded))
		}
	}
	if isJSONRawMessageType(target.Type()) {
		end, valid := scanJSONValue(text, pos)
		if !valid {
			return pos, newMarshalError("json: invalid value")
		}
		target.Set(reflect.ValueOf(RawMessage([]byte(text[pos:end]))))
		return end, nil
	}
	if nullEnd, nullOK := scanJSONLiteral(text, pos, "null"); nullOK {
		if target.Kind() == reflect.Interface || target.Kind() == reflect.Pointer || target.Kind() == reflect.Map || target.Kind() == reflect.Slice {
			target.SetZero()
		}
		return nullEnd, nil
	}
	targetType := target.Type()
	kind := target.Kind()
	if (kind == reflect.Struct || kind == reflect.Map) && text[pos] != '{' || (kind == reflect.Array || kind == reflect.Slice && target.Type().Elem().Kind() != reflect.Uint8) && text[pos] != '[' {
		return jsonTypeMismatch(text, pos, target)
	}
	targetTypeText := jsonReflectTypeText(targetType)
	if targetTypeText == "Any" || target.Kind() == reflect.Interface {
		return unmarshalAny(text, pos, target, options)
	}
	switch target.Kind() {
		case reflect.Bool, reflect.String, reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64, reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr, reflect.Float32, reflect.Float64, reflect.Complex64, reflect.Complex128:
			return unmarshalPrimitive(text, pos, target, options)
		case reflect.Struct:
			return unmarshalStruct(text, pos, target, options)
		case reflect.Array:
			return unmarshalSequence(text, pos, target, options)
		case reflect.Slice:
			if target.Type().Elem().Kind() == reflect.Uint8 && text[pos] != '[' {
				encoded, end, ok := parseJSONStringValue(text, pos)
				if !ok {
					return jsonTypeMismatch(text, pos, target)
				}
				data, err := base64.StdEncoding.DecodeString(encoded)
				if err != nil {
					return pos, err
				}
				out := reflect.MakeSlice(target.Type(), len(data), len(data))
				for i := 0; i < len(data); i++ {
					out.Index(i).SetUint(uint64(data[i]))
				}
				target.Set(out)
				return end, nil
			}
			return unmarshalSequence(text, pos, target, options)
		case reflect.Map:
			return unmarshalMap(text, pos, target, options)
		case reflect.Pointer:
			if target.IsNil() {
				allocated := reflect.New(target.Type().Elem())
				target.Set(allocated)
				return unmarshalValue(text, pos, allocated.Elem(), options)
			}
			return unmarshalValue(text, pos, target.Elem(), options)
		default:
			skipEnd, skipOK := scanJSONValue(text, pos)
			if !skipOK {
				return pos, newMarshalError("json: invalid value")
			}
			return skipEnd, newMarshalError("json: unsupported unmarshal target kind " + target.Kind().String())
	}
}

func jsonTypeMismatch(text string, pos int, target reflect.Value) (int, error) {
	end, _ := scanJSONValue(text, pos)
	value := "number " + text[pos:end]
	switch text[pos] {
		case '"':
			value = "string"
		case '[':
			value = "array"
		case '{':
			value = "object"
		case 't', 'f':
			value = "bool"
	}
	return end, &UnmarshalTypeError{Value: value, Type: target.Type(), Offset: int64(end)}
}

func unmarshalPrimitive(text string, pos int, target reflect.Value, options decodeOptions) (int, error) {
	end, _ := scanJSONValue(text, pos)
	if isJSONNumberType(target.Type()) {
		if text[pos] == '"' {
			value, _, _ := parseJSONStringValue(text, pos)
			if !Valid([]byte(value)) || len(value) == 0 || !(value[0] == '-' || value[0] >= '0' && value[0] <= '9') {
				return jsonTypeMismatch(text, pos, target)
			}
			target.SetString(value)
			return end, nil
		}
		if _, ok := scanJSONNumber(text, pos); !ok {
			return jsonTypeMismatch(text, pos, target)
		}
		target.SetString(text[pos:end])
		return end, nil
	}
	switch target.Kind() {
		case reflect.String:
			value, _, ok := parseJSONStringValue(text, pos)
			if !ok {
				return jsonTypeMismatch(text, pos, target)
			}
			target.SetString(value)
		case reflect.Bool:
			if text[pos:end] != "true" && text[pos:end] != "false" {
				return jsonTypeMismatch(text, pos, target)
			}
			target.SetBool(text[pos:end] == "true")
		case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
			value, err := strconv.ParseInt(text[pos:end], 10, target.Type().Bits())
			if err != nil {
				return jsonTypeMismatch(text, pos, target)
			}
			target.SetInt(value)
		case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
			value, err := strconv.ParseUint(text[pos:end], 10, target.Type().Bits())
			if err != nil {
				return jsonTypeMismatch(text, pos, target)
			}
			target.SetUint(value)
		case reflect.Float32, reflect.Float64:
			value, err := strconv.ParseFloat(text[pos:end], target.Type().Bits())
			if err != nil {
				return jsonTypeMismatch(text, pos, target)
			}
			target.SetFloat(value)
		default:
			return jsonTypeMismatch(text, pos, target)
	}
	return end, nil
}

func unmarshalStruct(text string, pos int, target reflect.Value, options decodeOptions) (int, error) {
	if pos >= len(text) || text[pos:pos + 1] != "{" {
		return pos, newMarshalError("json: expected object")
	}
	typ := target.Type()
	fields, cached := options.fields[typ]
	if !cached {
		fields = jsonVisibleFields(typ)
		if len(options.fields) < 256 {
			options.fields[typ] = fields
		}
	}
	pos = skipJSONSpace(text, pos + 1)
	if pos < len(text) && text[pos:pos + 1] == "}" {
		return pos + 1, nil
	}
	for {
		key, nextKey, keyOK := parseJSONStringValue(text, pos)
		if !keyOK {
			return pos, newMarshalError("json: expected object key")
		}
		pos = skipJSONSpace(text, nextKey)
		if pos >= len(text) || text[pos:pos + 1] != ":" {
			return pos, newMarshalError("json: expected colon")
		}
		pos = skipJSONSpace(text, pos + 1)
		field, found := jsonFieldByJSONName(fields, key)
		if found {
			previousError := *options.firstError
			fieldValue := jsonFieldValue(target, field.Field.Index, true)
			if !fieldValue.IsValid() {
				return pos, newMarshalError("json: cannot set embedded field")
			}
			fieldEnd := pos
			var fieldErr error
			if field.Quoted && jsonQuotedKind(fieldValue.Kind()) && text[pos:pos + 1] != "n" {
				var inner string
				var ok bool
				inner, fieldEnd, ok = parseJSONStringValue(text, pos)
				if !ok {
					return pos, newMarshalError("json: invalid use of ,string struct tag")
				}
				if err := checkValid([]byte(inner), newScanner()); err != nil {
					return pos, err
				}
				_, fieldErr = unmarshalValue(inner, 0, fieldValue, options)
			} else {
				fieldEnd, fieldErr = unmarshalValue(text, pos, fieldValue, options)
			}
			if fieldErr != nil {
				return pos, fieldErr
			}
			if previousError == nil && *options.firstError != nil {
				if typeError, ok := (*options.firstError).(*UnmarshalTypeError); ok {
					if typeError.Field != "" {
						typeError.Field = field.Field.Name + "." + typeError.Field
					} else {
						typeError.Field = field.Field.Name
					}
					typeError.Struct = target.Type().Name()
				}
			}
			pos = fieldEnd
		} else {
			if options.disallowUnknownFields {
				if *options.firstError == nil {
					*options.firstError = errors.New("json: unknown field " + strconv.Quote(key))
				}
			}
			unknownEnd, unknownOK := scanJSONValue(text, pos)
			if !unknownOK {
				return pos, newMarshalError("json: invalid object value")
			}
			pos = unknownEnd
		}
		pos = skipJSONSpace(text, pos)
		if pos < len(text) && text[pos:pos + 1] == "}" {
			return pos + 1, nil
		}
		if pos >= len(text) || text[pos:pos + 1] != "," {
			return pos, newMarshalError("json: expected comma")
		}
		pos = skipJSONSpace(text, pos + 1)
	}
	return pos, newMarshalError("json: invalid object")
}

func unmarshalSequence(text string, pos int, target reflect.Value, options decodeOptions) (int, error) {
	if pos >= len(text) || text[pos] != '[' {
		return jsonTypeMismatch(text, pos, target)
	}
	fixed := target.Kind() == reflect.Array
	out := target
	if !fixed {
		out = reflect.MakeSlice(target.Type(), 0, 0)
	}
	index := 0
	pos = skipJSONSpace(text, pos + 1)
	for pos < len(text) && text[pos] != ']' {
		end := pos
		var err error
		if fixed && index >= target.Len() {
			end, _ = scanJSONValue(text, pos)
		} else {
			item := reflect.Value{}
			if fixed {
				item = target.Index(index)
			} else {
				item = reflect.New(target.Type().Elem()).Elem()
			}
			end, err = unmarshalValue(text, pos, item, options)
			if err != nil {
				return end, err
			}
			if !fixed {
				out = reflect.Append(out, item)
			}
		}
		index++
		pos = skipJSONSpace(text, end)
		if pos < len(text) && text[pos] == ',' {
			pos = skipJSONSpace(text, pos + 1)
		}
	}
	if fixed {
		for i := index; i < target.Len(); i++ {
			target.Index(i).SetZero()
		}
	} else {
		target.Set(out)
	}
	return pos + 1, nil
}

func unmarshalMap(text string, pos int, target reflect.Value, options decodeOptions) (int, error) {
	if pos >= len(text) || text[pos:pos + 1] != "{" {
		return pos, newMarshalError("json: expected object")
	}
	out := target
	if target.IsNil() {
		out = reflect.MakeMap(target.Type())
		target.Set(out)
	}
	keyType := target.Type().Key()
	elemType := target.Type().Elem()
	pos = skipJSONSpace(text, pos + 1)
	if pos < len(text) && text[pos:pos + 1] == "}" {
		target.Set(out)
		return pos + 1, nil
	}
	for {
		keyText, keyEnd, keyOK := parseJSONStringValue(text, pos)
		if !keyOK {
			return pos, newMarshalError("json: expected object key")
		}
		mapKey, mapKeyErr := jsonMapKeyValue(keyText, keyType)
		if mapKeyErr != nil {
			if _, numeric := mapKeyErr.(*strconv.NumError); !numeric {
				return pos, mapKeyErr
			}
			if *options.firstError == nil {
				*options.firstError = &UnmarshalTypeError{Value: "number " + keyText, Type: keyType, Offset: int64(keyEnd - 1)}
			}
		}
		pos = skipJSONSpace(text, keyEnd)
		if pos >= len(text) || text[pos:pos + 1] != ":" {
			return pos, newMarshalError("json: expected colon")
		}
		elem := reflect.New(elemType).Elem()
		elemEnd, elemErr := unmarshalValue(text, skipJSONSpace(text, pos + 1), elem, options)
		if elemErr != nil {
			return pos, elemErr
		}
		if mapKeyErr == nil {
			out.SetMapIndex(mapKey, elem)
		}
		pos = skipJSONSpace(text, elemEnd)
		if pos < len(text) && text[pos:pos + 1] == "}" {
			target.Set(out)
			return pos + 1, nil
		}
		if pos >= len(text) || text[pos:pos + 1] != "," {
			return pos, newMarshalError("json: expected comma")
		}
		pos = skipJSONSpace(text, pos + 1)
	}
	return pos, newMarshalError("json: invalid object")
}

func unmarshalAny(text string, pos int, target reflect.Value, options decodeOptions) (int, error) {
	value, next, err := parseJSONAny(text, pos, options)
	if err != nil {
		return pos, err
	}
	if value == nil {
		target.SetZero()
	} else {
		target.Set(reflect.ValueOf(value))
	}
	return next, nil
}

func jsonFieldByJSONName(fields []jsonStructField, name string) (jsonStructField, bool) {
	for i := 0; i < len(fields); i++ {
		if fields[i].Name == name {
			return fields[i], true
		}
	}
	for _, field := range fields {
		if strings.EqualFold(field.Name, name) {
			return field, true
		}
	}
	return jsonStructField{}, false
}

func jsonMapKeyValue(key string, typ reflect.Type) (reflect.Value, error) {
	value := reflect.New(typ)
	if value.CanInterface() {
		if unmarshaler, ok := value.Interface().(encoding.TextUnmarshaler); ok {
			if err := unmarshaler.UnmarshalText([]byte(key)); err != nil {
				return reflect.Value{}, err
			}
			return value.Elem(), nil
		}
	}
	kind := typ.Kind()
	switch {
		case kind == reflect.String:
			value.Elem().SetString(key)
			return value.Elem(), nil
		case kind >= reflect.Int && kind <= reflect.Int64:
			number, err := strconv.ParseInt(key, 10, typ.Bits())
			if err != nil {
				return reflect.Value{}, err
			}
			value.Elem().SetInt(number)
			return value.Elem(), nil
		case kind >= reflect.Uint && kind <= reflect.Uintptr:
			number, err := strconv.ParseUint(key, 10, typ.Bits())
			if err != nil {
				return reflect.Value{}, err
			}
			value.Elem().SetUint(number)
			return value.Elem(), nil
		default:
			return reflect.Value{}, newMarshalError("json: unsupported map key type " + typ.String())
	}
}

func parseJSONAny(text string, pos int, options decodeOptions) (any, int, error) {
	pos = skipJSONSpace(text, pos)
	if literalEnd, literalOK := scanJSONLiteral(text, pos, "null"); literalOK {
		return nil, literalEnd, nil
	}
	if trueEnd, trueOK := scanJSONLiteral(text, pos, "true"); trueOK {
		return true, trueEnd, nil
	}
	if falseEnd, falseOK := scanJSONLiteral(text, pos, "false"); falseOK {
		return false, falseEnd, nil
	}
	if pos < len(text) && text[pos:pos + 1] == "\"" {
		value, next, ok := parseJSONStringValue(text, pos)
		if !ok {
			return nil, pos, newMarshalError("json: expected string")
		}
		return value, next, nil
	}
	if pos < len(text) && text[pos:pos + 1] == "[" {
		return parseJSONArrayAny(text, pos, options)
	}
	if pos < len(text) && text[pos:pos + 1] == "{" {
		return parseJSONObjectAny(text, pos, options)
	}
	if pos < len(text) && (text[pos:pos + 1] == "-" || isJSONDigit(text[pos:pos + 1])) {
		numberEnd, numberOK := scanJSONNumber(text, pos)
		if !numberOK {
			return nil, pos, newMarshalError("json: expected number")
		}
		if options.useNumber {
			return Number(text[pos:numberEnd]), numberEnd, nil
		}
		numberValue, numberErr := strconv.ParseFloat(text[pos:numberEnd], 64)
		if numberErr != nil {
			if *options.firstError == nil {
				*options.firstError = &UnmarshalTypeError{Value: "number " + text[pos:numberEnd], Type: reflect.TypeOf(float64(0)), Offset: int64(numberEnd)}
			}
			return nil, numberEnd, nil
		}
		return numberValue, numberEnd, nil
	}
	return nil, pos, newMarshalError("json: invalid value")
}

func parseJSONArrayAny(text string, pos int, options decodeOptions) (any, int, error) {
	items := []any{}
	pos = skipJSONSpace(text, pos + 1)
	if pos < len(text) && text[pos:pos + 1] == "]" {
		return items, pos + 1, nil
	}
	for {
		item, itemEnd, itemErr := parseJSONAny(text, pos, options)
		if itemErr != nil {
			return nil, pos, itemErr
		}
		items = append(items, item)
		pos = skipJSONSpace(text, itemEnd)
		if pos < len(text) && text[pos:pos + 1] == "]" {
			return items, pos + 1, nil
		}
		if pos >= len(text) || text[pos:pos + 1] != "," {
			return nil, pos, newMarshalError("json: expected comma")
		}
		pos = skipJSONSpace(text, pos + 1)
	}
	return nil, pos, newMarshalError("json: invalid array")
}

func parseJSONObjectAny(text string, pos int, options decodeOptions) (any, int, error) {
	out := map[string]any{}
	pos = skipJSONSpace(text, pos + 1)
	if pos < len(text) && text[pos:pos + 1] == "}" {
		return out, pos + 1, nil
	}
	for {
		key, keyEnd, keyOK := parseJSONStringValue(text, pos)
		if !keyOK {
			return nil, pos, newMarshalError("json: expected object key")
		}
		pos = skipJSONSpace(text, keyEnd)
		if pos >= len(text) || text[pos:pos + 1] != ":" {
			return nil, pos, newMarshalError("json: expected colon")
		}
		value, valueEnd, valueErr := parseJSONAny(text, skipJSONSpace(text, pos + 1), options)
		if valueErr != nil {
			return nil, pos, valueErr
		}
		out[key] = value
		pos = skipJSONSpace(text, valueEnd)
		if pos < len(text) && text[pos:pos + 1] == "}" {
			return out, pos + 1, nil
		}
		if pos >= len(text) || text[pos:pos + 1] != "," {
			return nil, pos, newMarshalError("json: expected comma")
		}
		pos = skipJSONSpace(text, pos + 1)
	}
	return nil, pos, newMarshalError("json: invalid object")
}

func parseJSONStringValue(text string, pos int) (string, int, bool) {
	if pos >= len(text) || text[pos:pos + 1] != "\"" {
		return "", pos, false
	}
	pos++
	plainStart := pos
	segmentStart := pos
	var out strings.Builder
	for pos < len(text) {
		ch := text[pos:pos + 1]
		if ch == "\"" {
			if out.Len() == 0 && segmentStart == plainStart {
				return text[plainStart:pos], pos + 1, true
			}
			out.WriteString(text[segmentStart:pos])
			return out.String(), pos + 1, true
		}
		if ch == "\\" {
			if pos + 1 >= len(text) {
				return "", pos, false
			}
			out.WriteString(text[segmentStart:pos])
			esc := text[pos + 1:pos + 2]
			switch esc {
				case "\"", "\\", "/":
					out.WriteString(esc)
					pos += 2
				case "b":
					out.WriteString("\b")
					pos += 2
				case "f":
					out.WriteString("\f")
					pos += 2
				case "n":
					out.WriteString("\n")
					pos += 2
				case "r":
					out.WriteString("\r")
					pos += 2
				case "t":
					out.WriteString("\t")
					pos += 2
				case "u":
					value, next, unicodeOK := parseJSONUnicodeEscape(text, pos + 2)
					if !unicodeOK {
						return "", pos, false
					}
					pos = next
					if isHighSurrogate(value) {
						if pos + 6 <= len(text) && text[pos:pos + 2] == "\\u" {
							low, lowNext, lowOK := parseJSONUnicodeEscape(text, pos + 2)
							if lowOK && isLowSurrogate(low) {
								value = 65536 + (value - 55296) * 1024 + (low - 56320)
								pos = lowNext
							} else {
								value = int(utf8.RuneError)
							}
						} else {
							value = int(utf8.RuneError)
						}
					} else if isLowSurrogate(value) {
						value = int(utf8.RuneError)
					}
					out.WriteRune(rune(value))
				default:
					return "", pos, false
			}
			segmentStart = pos
			continue
		}
		if ch < " " {
			return "", pos, false
		}
		pos++
	}
	return "", pos, false
}

func parseJSONUnicodeEscape(text string, pos int) (int, int, bool) {
	if pos + 4 > len(text) {
		return 0, pos, false
	}
	value := 0
	for i := 0; i < 4; i++ {
		digit, ok := jsonHexValue(text[pos + i:pos + i + 1])
		if !ok {
			return 0, pos, false
		}
		value = value * 16 + digit
	}
	return value, pos + 4, true
}

func jsonHexValue(ch string) (int, bool) {
	if ch >= "0" && ch <= "9" {
		return int(ch[0]) - int(byte('0')), true
	}
	if ch >= "a" && ch <= "f" {
		return int(ch[0]) - int(byte('a')) + 10, true
	}
	if ch >= "A" && ch <= "F" {
		return int(ch[0]) - int(byte('A')) + 10, true
	}
	return 0, false
}

func isHighSurrogate(value int) bool {
	return value >= 55296 && value <= 56319
}

func isLowSurrogate(value int) bool {
	return value >= 56320 && value <= 57343
}

func jsonReflectTypeText(typ reflect.Type) string {
	switch typ.Kind() {
		case reflect.Bool:
			return "Bool"
		case reflect.String:
			return "String"
		case reflect.Int:
			return "Int"
		case reflect.Int8:
			return "Int8"
		case reflect.Int16:
			return "Int16"
		case reflect.Int32:
			return "Int32"
		case reflect.Int64:
			return "Int64"
		case reflect.Uint:
			return "Uint"
		case reflect.Uint8:
			return "Uint8"
		case reflect.Uint16:
			return "Uint16"
		case reflect.Uint32:
			return "Uint32"
		case reflect.Uint64:
			return "Uint64"
		case reflect.Uintptr:
			return "Uintptr"
		case reflect.Float32:
			return "Float32"
		case reflect.Float64:
			return "Float64"
		case reflect.Complex64:
			return "Complex64"
		case reflect.Complex128:
			return "Complex128"
	}
	return typ.String()
}

func isJSONNumberType(typ reflect.Type) bool {
	return typ.PkgPath() == "encoding/json" && typ.Name() == "Number"
}

func isJSONRawMessageType(typ reflect.Type) bool {
	return typ.PkgPath() == "encoding/json" && typ.Name() == "RawMessage"
}

func isJSONSignedType(typ string) bool {
	return typ == "Int" || typ == "Int8" || typ == "Int16" || typ == "Int32" || typ == "Int64"
}

func isJSONUnsignedType(typ string) bool {
	return typ == "Uint" || typ == "Uint8" || typ == "Uint16" || typ == "Uint32" || typ == "Uint64" || typ == "Uintptr"
}

func isJSONFloatType(typ string) bool {
	return typ == "Float32" || typ == "Float64"
}
