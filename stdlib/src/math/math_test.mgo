package math_test

import (
	"math"
	"testing"
)

func TestMathFloatClassification(t *testing.T) {
	if math.IsNaN(1.0) || math.IsInf(1.0, 0) || math.IsInf(1.0, 1) || math.IsInf(1.0, -1) {
		t.Fatal("finite values were classified incorrectly")
	}
	if math.Trunc(3.75) != 3.0 || math.Trunc(-3.75) != -3.0 {
		t.Fatal("Trunc returned the wrong value")
	}
}

func TestMathRounding(t *testing.T) {
	if math.Abs(-3.5) != 3.5 || math.Floor(3.75) != 3.0 || math.Floor(-3.25) != -4.0 {
		t.Fatal("rounding toward negative infinity failed")
	}
	if math.Ceil(3.25) != 4.0 || math.Ceil(-3.75) != -3.0 {
		t.Fatal("rounding toward positive infinity failed")
	}
	if math.Round(2.5) != 3.0 || math.Round(-2.5) != -3.0 || math.Round(2.25) != 2.0 {
		t.Fatal("half-away-from-zero rounding failed")
	}
}

func TestMathComparison(t *testing.T) {
	if math.Max(3.0, 5.0) != 5.0 || math.Min(3.0, 5.0) != 3.0 {
		t.Fatal("Max or Min returned the wrong value")
	}
	if !math.Signbit(-1.0) || math.Signbit(1.0) {
		t.Fatal("Signbit returned the wrong value")
	}
	if math.Copysign(3.0, -1.0) != -3.0 || math.Copysign(-3.0, 1.0) != 3.0 {
		t.Fatal("Copysign returned the wrong value")
	}
}

func TestMathFloatBitsPreserveRepresentation(t *testing.T) {
	const payload64 uint64 = 0x7ff8000000001234
	if got := math.Float64bits(math.Float64frombits(payload64)); got != payload64 {
		t.Fatalf("Float64 bit round trip = %#x", got)
	}
	const payload32 uint32 = 0x7fc01234
	if got := math.Float32bits(math.Float32frombits(payload32)); got != payload32 {
		t.Fatalf("Float32 bit round trip = %#x", got)
	}
	if math.Float64bits(math.Float64frombits(uint64(1))) != uint64(1) {
		t.Fatal("Float64 bit round trip lost the smallest subnormal")
	}
	if math.Float64bits(math.Float64frombits(uint64(1) << 63)) != uint64(1) << 63 {
		t.Fatal("Float64 bit round trip lost negative zero")
	}
}

func TestMathSignedZeroAndExtremeScaling(t *testing.T) {
	negativeZero := math.Float64frombits(0x8000000000000000)
	if !math.Signbit(negativeZero) || math.Float64bits(math.Abs(negativeZero)) != 0 || math.Float64bits(math.Copysign(1, negativeZero)) != 0xbff0000000000000 {
		t.Fatal("IEEE sign operation lost negative zero")
	}
	if !math.IsInf(math.Ldexp(1, 1 << 62), 1) || math.Float64bits(math.Ldexp(-1, -(1 << 62))) != 0x8000000000000000 {
		t.Fatal("extreme scale did not saturate with the original sign")
	}
}
