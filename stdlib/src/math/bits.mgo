package math

import "math/floatbits"

// Float64bits returns the IEEE 754 binary representation of f, with the sign
// bit of f and the result in the same bit position.
func Float64bits(f float64) uint64 {
	return floatbits.Float64bits(f)
}

// Float64frombits returns the floating-point number corresponding to b, with
// the sign bit of b and the result in the same bit position.
func Float64frombits(b uint64) float64 {
	return floatbits.Float64frombits(b)
}

// Float32bits returns the IEEE 754 binary representation of f, with the sign
// bit of f and the result in the same bit position.
func Float32bits(f float32) uint32 {
	return floatbits.Float32bits(f)
}

// Float32frombits returns the floating-point number corresponding to b, with
// the sign bit of b and the result in the same bit position.
func Float32frombits(b uint32) float32 {
	return floatbits.Float32frombits(b)
}
