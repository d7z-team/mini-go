package strconv

import "math/floatbits"

// Go 1.26.6 internal/strconv uses unsafe for these bit operations. Mini-Go's
// mathematical bit conversions preserve the same IEEE values without pointers.
func float64frombits(b uint64) float64 {
	return floatbits.Float64frombits(b)
}

func float32frombits(b uint32) float32 {
	return floatbits.Float32frombits(b)
}

func float64bits(f float64) uint64 {
	return floatbits.Float64bits(f)
}

func float32bits(f float32) uint32 {
	return floatbits.Float32bits(f)
}

func inf(sign int) float64 {
	return floatbits.Inf(sign)
}

func isNaN(f float64) bool {
	return floatbits.IsNaN(f)
}

func nan() float64 {
	return floatbits.NaN()
}

// ParseComplex converts a real or imaginary floating-point representation to
// complex64 or complex128 precision. Errors retain their input and category.
func ParseComplex(s string, bitSize int) (complex128, error) {
	value, err := parseComplex(s, bitSize)
	if err != nil {
		return value, parseError("ParseComplex", s, err)
	}
	return value, nil
}
