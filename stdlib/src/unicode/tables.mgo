// Range entries: 4209 16-bit, 3026 32-bit, 7235 total.
// Range bytes: 25254 16-bit, 36312 32-bit, 61566 total.

// Fold orbit bytes: 94 pairs, 376 bytes

func unpackRangeTable(data []byte) *RangeTable {
	n16 := int(data[1]) << 8 | int(data[2])
	n32 := int(data[3]) << 8 | int(data[4])
	var r16 []Range16
	var r32 []Range32
	if data[0] & 1 != 0 {
		r16 = make([]Range16, n16)
	}
	if data[0] & 2 != 0 {
		r32 = make([]Range32, n32)
	}
	p := 7
	for i := range r16 {
		r16[i] = Range16{uint16(data[p]) << 8 | uint16(data[p + 1]), uint16(data[p + 2]) << 8 | uint16(data[p + 3]), uint16(data[p + 4]) << 8 | uint16(data[p + 5])}
		p += 6
	}
	for i := range r32 {
		r32[i] = Range32{uint32(data[p]) << 24 | uint32(data[p + 1]) << 16 | uint32(data[p + 2]) << 8 | uint32(data[p + 3]), uint32(data[p + 4]) << 24 | uint32(data[p + 5]) << 16 | uint32(data[p + 6]) << 8 | uint32(data[p + 7]), uint32(data[p + 8]) << 24 | uint32(data[p + 9]) << 16 | uint32(data[p + 10]) << 8 | uint32(data[p + 11])}
		p += 12
	}
	return &RangeTable{R16: r16, R32: r32, LatinOffset: int(data[5]) << 8 | int(data[6])}
}

func unpackCaseRanges(data []byte) []CaseRange {
	result := make([]CaseRange, len(data) / 20)
	p := 0
	for i := range result {
		result[i] = CaseRange{uint32(data[p]) << 24 | uint32(data[p + 1]) << 16 | uint32(data[p + 2]) << 8 | uint32(data[p + 3]), uint32(data[p + 4]) << 24 | uint32(data[p + 5]) << 16 | uint32(data[p + 6]) << 8 | uint32(data[p + 7]), d{rune(uint32(data[p + 8]) << 24 | uint32(data[p + 9]) << 16 | uint32(data[p + 10]) << 8 | uint32(data[p + 11])), rune(uint32(data[p + 12]) << 24 | uint32(data[p + 13]) << 16 | uint32(data[p + 14]) << 8 | uint32(data[p + 15])), rune(uint32(data[p + 16]) << 24 | uint32(data[p + 17]) << 16 | uint32(data[p + 18]) << 8 | uint32(data[p + 19]))}}
		p += 20
	}
	return result
}
