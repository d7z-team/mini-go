package reflect

import "strconv/literal"

func typeDescriptor(typ Type) runtimeTypeData {
	descriptor, message, ok := runtimeTypeDescriptor(typ)
	if ok {
		return descriptor
	}
	panic(message)
}

func typeIdentity(typ Type) string {
	return typeDescriptor(typ).key
}

func typeMeasure(typ Type, property string) uint64 {
	value, message, ok := runtimeTypeMeasure(typ, property)
	if !ok {
		panic(message)
	}
	return value
}

func numField(typ Type) int {
	if typ.Kind() != Struct {
		panic("reflect: NumField of non-struct type " + typ.String())
	}
	return int(typeMeasure(typ, "fields"))
}

func fieldAt(typ Type, index int) StructField {
	field, message, ok := runtimeTypeField(typ, index)
	if ok {
		return field
	}
	panic(message)
}

func fieldByIndex(typ Type, index []int) StructField {
	if len(index) == 0 {
		panic("reflect: empty field index")
	}
	current := typ
	var field StructField
	for i := 0; i < len(index); i++ {
		field = fieldAt(current, index[i])
		if i + 1 == len(index) {
			if len(field.Index) == 0 {
				field.Index = copyIndex(index)
			}
			return field
		}
		next, ok := fieldStructType(field)
		if !ok {
			panic("reflect: non-struct field in index path")
		}
		current = next
	}
	return StructField{}
}

func fieldByName(typ Type, name string) (StructField, bool) {
	return fieldByNameFunc(typ, func(candidate string) bool {
		return candidate == name
	})
}

// Get returns the value associated with key in the tag string.
// If there is no such key in the tag, Get returns the empty string.
// If the tag does not have the conventional format, the value
// returned by Get is unspecified. To determine whether a tag is
// explicitly set to the empty string, use [StructTag.Lookup].
func (tag StructTag) Get(key string) string {
	value, ok := tag.Lookup(key)
	if !ok {
		return ""
	}
	return value
}

// Lookup returns the value associated with key in the tag string.
// If the key is present in the tag the value (which may be empty)
// is returned. Otherwise the returned value will be the empty string.
// The ok return value reports whether the value was explicitly set in
// the tag string. If the tag does not have the conventional format,
// the value returned by Lookup is unspecified.
func (tag StructTag) Lookup(key string) (string, bool) {
	text := string(tag)
	for text != "" {
		i := 0
		for i < len(text) && text[i] == ' ' {
			i++
		}
		text = text[i:]
		if text == "" {
			break
		}

		i = 0
		for i < len(text) && text[i] > ' ' && text[i] != ':' && text[i] != '"' && text[i] != 0x7f {
			i++
		}
		if i == 0 || i + 1 >= len(text) || text[i] != ':' || text[i + 1] != '"' {
			break
		}
		name := text[:i]
		text = text[i + 1:]

		i = 1
		for i < len(text) && text[i] != '"' {
			if text[i] == '\\' {
				i++
			}
			i++
		}
		if i >= len(text) {
			break
		}
		quoted := text[:i + 1]
		text = text[i + 1:]
		if key == name {
			value, err := literal.Unquote(quoted)
			if err != nil {
				break
			}
			return value, true
		}
	}
	return "", false
}

func numMethod(typ Type) int {
	return typeDescriptor(typ).methodCount
}

func methodAt(typ Type, index int) Method {
	method, message, ok := runtimeTypeMethod(typ, index)
	if ok {
		return method
	}
	panic(message)
}

func methodByName(typ Type, name string) (Method, bool) {
	for i := 0; i < typ.NumMethod(); i++ {
		method := typ.Method(i)
		if method.Name == name {
			return method, true
		}
	}
	return Method{}, false
}

func typeAlign(typ runtimeType) int {
	return int(typeMeasure(typ, "align"))
}

func typeFieldAlign(typ runtimeType) int {
	return int(typeMeasure(typ, "field_align"))
}

func typeSize(typ runtimeType) uintptr {
	return uintptr(typeMeasure(typ, "size"))
}

func typeBits(typ runtimeType) int {
	kind := typ.Kind()
	if kind < Int || kind > Complex128 {
		panic("reflect: Bits of non-numeric type")
	}
	bits := typeMeasure(typ, "bits")
	if bits == 0 {
		panic("reflect: Bits of non-numeric type")
	}
	return int(bits)
}

func typeOverflowComplex(typ runtimeType, value complex128) bool {
	switch typ.Kind() {
		case Complex64:
			const maxFloat32 = 3.4028234663852886e+38
			const maxFloat64 = 1.7976931348623157e+308
			realPart := real(value)
			if realPart < 0 {
				realPart = -realPart
			}
			imaginaryPart := imag(value)
			if imaginaryPart < 0 {
				imaginaryPart = -imaginaryPart
			}
			return maxFloat32 < realPart && realPart <= maxFloat64 || maxFloat32 < imaginaryPart && imaginaryPart <= maxFloat64
		case Complex128:
			return false
	}
	panic("reflect: OverflowComplex of non-complex type " + typ.String())
}

func typeOverflowFloat(typ runtimeType, value float64) bool {
	switch typ.Kind() {
		case Float32:
			const maxFloat32 = 3.4028234663852886e+38
			const maxFloat64 = 1.7976931348623157e+308
			if value < 0 {
				value = -value
			}
			return maxFloat32 < value && value <= maxFloat64
		case Float64:
			return false
	}
	panic("reflect: OverflowFloat of non-float type " + typ.String())
}

func typeOverflowInt(typ runtimeType, value int64) bool {
	switch typ.Kind() {
		case Int8:
			return value < -128 || value > 127
		case Int16:
			return value < -32768 || value > 32767
		case Int32:
			return value < -2147483648 || value > 2147483647
		case Int, Int64:
			return false
	}
	panic("reflect: OverflowInt of non-int type " + typ.String())
}

func typeOverflowUint(typ runtimeType, value uint64) bool {
	switch typ.Kind() {
		case Uint8:
			return value > 255
		case Uint16:
			return value > 65535
		case Uint32:
			return value > 4294967295
		case Uint, Uint64, Uintptr:
			return false
	}
	panic("reflect: OverflowUint of non-uint type " + typ.String())
}

func typeChanDir(typ runtimeType) ChanDir {
	descriptor := typeDescriptor(typ)
	if descriptor.chanDir == 0 {
		panic("reflect: ChanDir of non-chan type")
	}
	return descriptor.chanDir
}

func typePkgPath(typ runtimeType) string {
	return typeDescriptor(typ).pkgPath
}

func isZeroType(typ Type) bool {
	return typ == nil
}

func typeName(typ runtimeType) string {
	return typeDescriptor(typ).typeName
}

func typeKindName(typ runtimeType) Kind {
	kind, message, ok := runtimeTypeKind(typ)
	if !ok {
		panic(message)
	}
	return Kind(kind)
}

func typeString(typ runtimeType) string {
	descriptor := typeDescriptor(typ)
	return descriptor.displayName
}

func typeAssignableTo(typ runtimeType, target Type) bool {
	return runtimeAssignableTo(typ, target)
}

func typeConvertibleTo(typ runtimeType, target Type) bool {
	return runtimeConvertibleTo(typ, target)
}

func typeImplements(typ runtimeType, target Type) bool {
	return runtimeImplements(typ, target)
}

// PointerTo returns the pointer type with element t.
// For example, if t represents type Foo, PointerTo(t) represents *Foo.
func PointerTo(typ Type) Type {
	out, message, ok := runtimePointerTo(typ)
	if ok {
		return out
	}
	panic(message)
}

// PtrTo returns the pointer type with element t.
// For example, if t represents type Foo, PtrTo(t) represents *Foo.
//
// PtrTo is the old spelling of [PointerTo].
// The two functions behave identically.
//
// Deprecated: Superseded by [PointerTo].
func PtrTo(typ Type) Type {
	return PointerTo(typ)
}

// SliceOf returns the slice type with element type t.
// For example, if t represents int, SliceOf(t) represents []int.
func SliceOf(typ Type) Type {
	out, message, ok := runtimeSliceOf(typ)
	if ok {
		return out
	}
	panic(message)
}

// MapOf returns the map type with the given key and element types.
// For example, if k represents int and e represents string,
// MapOf(k, e) represents map[int]string.
//
// If the key type is not a valid map key type (that is, if it does
// not implement Go's == operator), MapOf panics.
func MapOf(key Type, elem Type) Type {
	out, message, ok := runtimeMapOf(key, elem)
	if ok {
		return out
	}
	panic(message)
}

// ArrayOf returns the array type with the given length and element type.
func ArrayOf(length int, elem Type) Type {
	out, message, ok := runtimeArrayOf(length, elem)
	if ok {
		return out
	}
	panic(message)
}

// ChanOf returns the channel type with the given direction and element type.
func ChanOf(dir ChanDir, elem Type) Type {
	out, message, ok := runtimeChanOf(dir, elem)
	if ok {
		return out
	}
	panic(message)
}

// FuncOf returns the function type with the given argument and result types.
func FuncOf(inputs []Type, outputs []Type, variadic bool) Type {
	out, message, ok := runtimeFuncOf(inputs, outputs, variadic)
	if ok {
		return out
	}
	panic(message)
}

// StructOf returns the struct type containing fields.
func StructOf(fields []StructField) Type {
	out, message, ok := runtimeStructOf(fields)
	if ok {
		return out
	}
	panic(message)
}

func typeElem(typ Type) Type {
	descriptor := typeDescriptor(typ)
	if descriptor.elem != nil {
		return descriptor.elem
	}
	panic("reflect: Elem of invalid type")
}

func typeKey(typ Type) Type {
	descriptor := typeDescriptor(typ)
	if descriptor.keyType != nil {
		return descriptor.keyType
	}
	panic("reflect: Key of non-map type")
}

func typeLen(typ Type) int {
	return int(typeMeasure(typ, "length"))
}

func typeComparable(typ Type) bool {
	return typeDescriptor(typ).comparable
}

func typeNumIn(typ Type) int {
	descriptor := typeDescriptor(typ)
	if descriptor.kind != Func {
		panic("reflect: NumIn of non-func type")
	}
	return len(descriptor.inputs)
}

func typeIn(typ Type, index int) Type {
	descriptor := typeDescriptor(typ)
	if descriptor.kind != Func {
		panic("reflect: In of non-func type")
	}
	return descriptor.inputs[index]
}

func typeNumOut(typ Type) int {
	descriptor := typeDescriptor(typ)
	if descriptor.kind != Func {
		panic("reflect: NumOut of non-func type")
	}
	return len(descriptor.outputs)
}

func typeOut(typ Type, index int) Type {
	descriptor := typeDescriptor(typ)
	if descriptor.kind != Func {
		panic("reflect: Out of non-func type")
	}
	return descriptor.outputs[index]
}

func typeIsVariadic(typ Type) bool {
	descriptor := typeDescriptor(typ)
	if descriptor.kind != Func {
		panic("reflect: IsVariadic of non-func type")
	}
	return descriptor.variadic
}

// Name returns the type's name within its package for a defined type.
// For other (non-defined) types it returns the empty string.
func (typ runtimeType) Name() string {
	return typeName(typ)
}

// Kind returns the specific kind of this type.
func (typ runtimeType) Kind() Kind {
	return typeKindName(typ)
}

// String returns a string representation of the type.
// The string representation may use shortened package names
// (e.g., base64 instead of "encoding/base64") and is not
// guaranteed to be unique among types. To test for type identity,
// compare the Types directly.
func (typ runtimeType) String() string {
	return typeString(typ)
}

func (typ runtimeType) reflectType() {}

// AssignableTo reports whether a value of the type is assignable to type u.
func (typ runtimeType) AssignableTo(target Type) bool {
	return typeAssignableTo(typ, target)
}

// ConvertibleTo reports whether a value of the type is convertible to type u.
// Even if ConvertibleTo returns true, the conversion may still panic.
// For example, a slice of type []T is convertible to *[N]T,
// but the conversion will panic if its length is less than N.
func (typ runtimeType) ConvertibleTo(target Type) bool {
	return typeConvertibleTo(typ, target)
}

// Implements reports whether the type implements the interface type u.
func (typ runtimeType) Implements(target Type) bool {
	return typeImplements(typ, target)
}

// NumMethod returns the number of methods accessible using Method.
//
// For a non-interface type, it returns the number of exported methods.
//
// For an interface type, it returns the number of exported and unexported methods.
func (typ runtimeType) NumMethod() int {
	return numMethod(typ)
}

// Method returns the i'th method in the type's method set.
// It panics if i is not in the range [0, NumMethod()).
//
// For a non-interface type T or *T, the returned Method's Type and Func
// fields describe a function whose first argument is the receiver,
// and only exported methods are accessible.
//
// For an interface type, the returned Method's Type field gives the
// method signature, without a receiver, and the Func field is nil.
//
// Methods are sorted in lexicographic order.
//
// Calling this method will force the linker to retain all exported methods in all packages.
// This may make the executable binary larger but will not affect execution time.
func (typ runtimeType) Method(index int) Method {
	return methodAt(typ, index)
}

// MethodByName returns the method with that name in the type's
// method set and a boolean indicating if the method was found.
//
// For a non-interface type T or *T, the returned Method's Type and Func
// fields describe a function whose first argument is the receiver.
//
// For an interface type, the returned Method's Type field gives the
// method signature, without a receiver, and the Func field is nil.
//
// Calling this method will cause the linker to retain all methods with this name in all packages.
// If the linker can't determine the name, it will retain all exported methods.
// This may make the executable binary larger but will not affect execution time.
func (typ runtimeType) MethodByName(name string) (Method, bool) {
	return methodByName(typ, name)
}

// IsExported reports whether the method is exported.
func (method Method) IsExported() bool {
	return method.PkgPath == ""
}

// Elem returns a type's element type.
// It panics if the type's Kind is not Array, Chan, Map, Pointer, or Slice.
func (typ runtimeType) Elem() Type {
	return typeElem(typ)
}

// Key returns a map type's key type.
// It panics if the type's Kind is not Map.
func (typ runtimeType) Key() Type {
	return typeKey(typ)
}

// Len returns an array type's length.
// It panics if the type's Kind is not Array.
func (typ runtimeType) Len() int {
	return typeLen(typ)
}

// Comparable reports whether values of this type are comparable.
// Even if Comparable returns true, the comparison may still panic.
// For example, values of interface type are comparable,
// but the comparison will panic if their dynamic type is not comparable.
func (typ runtimeType) Comparable() bool {
	return typeComparable(typ)
}

// CanSeq reports whether a [Value] with this type can be iterated over using [Value.Seq].
func (typ runtimeType) CanSeq() bool {
	switch typ.Kind() {
		case Int, Int8, Int16, Int32, Int64, Uint, Uint8, Uint16, Uint32, Uint64, Uintptr,
		Array, Slice, Chan, String, Map:
			return true
		case Pointer:
			return typ.Elem().Kind() == Array
		case Func:
			if typ.NumIn() != 1 || typ.NumOut() != 0 {
				return false
			}
			yield := typ.In(0)
			return yield.Kind() == Func && yield.NumIn() == 1 && yield.NumOut() == 1 && yield.Out(0).Kind() == Bool
	}
	return false
}

// CanSeq2 reports whether a [Value] with this type can be iterated over using [Value.Seq2].
func (typ runtimeType) CanSeq2() bool {
	switch typ.Kind() {
		case Array, Slice, String, Map:
			return true
		case Pointer:
			return typ.Elem().Kind() == Array
		case Func:
			if typ.NumIn() != 1 || typ.NumOut() != 0 {
				return false
			}
			yield := typ.In(0)
			return yield.Kind() == Func && yield.NumIn() == 2 && yield.NumOut() == 1 && yield.Out(0).Kind() == Bool
	}
	return false
}

// NumIn returns a function type's input parameter count.
// It panics if the type's Kind is not Func.
func (typ runtimeType) NumIn() int {
	return typeNumIn(typ)
}

// In returns the type of a function type's i'th input parameter.
// It panics if the type's Kind is not Func.
// It panics if i is not in the range [0, NumIn()).
func (typ runtimeType) In(index int) Type {
	return typeIn(typ, index)
}

// NumOut returns a function type's output parameter count.
// It panics if the type's Kind is not Func.
func (typ runtimeType) NumOut() int {
	return typeNumOut(typ)
}

// Out returns the type of a function type's i'th output parameter.
// It panics if the type's Kind is not Func.
// It panics if i is not in the range [0, NumOut()).
func (typ runtimeType) Out(index int) Type {
	return typeOut(typ, index)
}

// IsVariadic reports whether a function type's final input parameter
// is a "..." parameter. If so, t.In(t.NumIn() - 1) returns the parameter's
// implicit actual type []T.
//
// For concreteness, if t represents func(x int, y ... float64), then
//
//	t.NumIn() == 2
//	t.In(0) is the reflect.Type for "int"
//	t.In(1) is the reflect.Type for "[]float64"
//	t.IsVariadic() == true
//
// IsVariadic panics if the type's Kind is not Func.
func (typ runtimeType) IsVariadic() bool {
	return typeIsVariadic(typ)
}

// Align returns the alignment in bytes of a value of
// this type when allocated in memory.
func (typ runtimeType) Align() int {
	return typeAlign(typ)
}

// FieldAlign returns the alignment in bytes of a value of
// this type when used as a field in a struct.
func (typ runtimeType) FieldAlign() int {
	return typeFieldAlign(typ)
}

// Size returns the number of bytes needed to store
// a value of the given type; it is analogous to unsafe.Sizeof.
func (typ runtimeType) Size() uintptr {
	return typeSize(typ)
}

// Bits returns the size of the type in bits.
// It panics if the type's Kind is not one of the
// sized or unsized Int, Uint, Float, or Complex kinds.
func (typ runtimeType) Bits() int {
	return typeBits(typ)
}

// OverflowComplex reports whether the complex128 value x cannot be represented by type typ.
// It panics if typ's Kind is not Complex64 or Complex128.
func (typ runtimeType) OverflowComplex(value complex128) bool {
	return typeOverflowComplex(typ, value)
}

// OverflowFloat reports whether the float64 value x cannot be represented by type typ.
// It panics if typ's Kind is not Float32 or Float64.
func (typ runtimeType) OverflowFloat(value float64) bool {
	return typeOverflowFloat(typ, value)
}

// OverflowInt reports whether the int64 value x cannot be represented by type typ.
// It panics if typ's Kind is not a signed integer kind.
func (typ runtimeType) OverflowInt(value int64) bool {
	return typeOverflowInt(typ, value)
}

// OverflowUint reports whether the uint64 value x cannot be represented by type typ.
// It panics if typ's Kind is not an unsigned integer kind.
func (typ runtimeType) OverflowUint(value uint64) bool {
	return typeOverflowUint(typ, value)
}

// ChanDir returns a channel type's direction.
// It panics if the type's Kind is not Chan.
func (typ runtimeType) ChanDir() ChanDir {
	return typeChanDir(typ)
}

// PkgPath returns a defined type's package path, that is, the import path
// that uniquely identifies the package, such as "encoding/base64".
// If the type was predeclared (string, error) or not defined (*T, struct{},
// []int, or A where A is an alias for a non-defined type), the package path
// will be the empty string.
func (typ runtimeType) PkgPath() string {
	return typePkgPath(typ)
}

// NumField returns a struct type's field count.
// It panics if the type's Kind is not Struct.
func (typ runtimeType) NumField() int {
	return numField(typ)
}

// Field returns a struct type's i'th field.
// It panics if the type's Kind is not Struct.
// It panics if i is not in the range [0, NumField()).
func (typ runtimeType) Field(index int) StructField {
	return fieldAt(typ, index)
}

// FieldByIndex returns the nested field corresponding
// to the index sequence. It is equivalent to calling Field
// successively for each index i.
// It panics if the type's Kind is not Struct.
func (typ runtimeType) FieldByIndex(index []int) StructField {
	return fieldByIndex(typ, index)
}

// FieldByName returns the struct field with the given name
// and a boolean indicating if the field was found.
// If the returned field is promoted from an embedded struct,
// then Offset in the returned StructField is the offset in
// the embedded struct.
func (typ runtimeType) FieldByName(name string) (StructField, bool) {
	return fieldByName(typ, name)
}

// FieldByNameFunc returns the struct field with a name that satisfies match.
// It follows the same breadth-first promotion and ambiguity rules as FieldByName.
func (typ runtimeType) FieldByNameFunc(match func(string) bool) (StructField, bool) {
	return fieldByNameFunc(typ, match)
}

// IsExported reports whether the field is exported.
func (field StructField) IsExported() bool {
	return field.PkgPath == ""
}
