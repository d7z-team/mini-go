package url

import "sort"

// Values maps a string key to a list of values.
// It is typically used for query parameters and form values.
// Unlike in the http.Header map, the keys in a Values map
// are case-sensitive.
type Values map[string][]string

// Clone creates a deep copy of the values, preserving nil maps and slices.
func (v Values) Clone() Values {
	if v == nil {
		return nil
	}
	result := make(Values, len(v))
	for key, values := range v {
		if values == nil {
			result[key] = nil
			continue
		}
		cloned := make([]string, len(values))
		copy(cloned, values)
		result[key] = cloned
	}
	return result
}

// Get gets the first value associated with the given key.
// If there are no values associated with the key, Get returns
// the empty string. To access multiple values, use the map
// directly.
func (v Values) Get(key string) string {
	values := v[key]
	if len(values) == 0 {
		return ""
	}
	return values[0]
}

// Set sets the key to value. It replaces any existing
// values.
func (v Values) Set(key, value string) {
	v[key] = []string{value}
}

// Add adds the value to key. It appends to any existing
// values associated with key.
func (v Values) Add(key, value string) {
	v[key] = append(v[key], value)
}

// Del deletes the values associated with key.
func (v Values) Del(key string) {
	delete(v, key)
}

// Has checks whether a given key is set.
func (v Values) Has(key string) bool {
	_, ok := v[key]
	return ok
}

// Encode encodes the values into “URL encoded” form
// ("bar=baz&foo=quux") sorted by key.
func (v Values) Encode() string {
	keys := []string{}
	for key := range v {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	out := ""
	for _, key := range keys {
		for _, value := range v[key] {
			if out != "" {
				out += "&"
			}
			out += QueryEscape(key) + "=" + QueryEscape(value)
		}
	}
	return out
}

// ParseQuery parses the URL-encoded query string and returns
// a map listing the values specified for each key.
// ParseQuery always returns a non-nil map containing all the
// valid query parameters found; err describes the first decoding error
// encountered, if any.
//
// Query is expected to be a list of key=value settings separated by ampersands.
// A setting without an equals sign is interpreted as a key set to an empty
// value.
// Settings containing a non-URL-encoded semicolon are considered invalid.
func ParseQuery(query string) (Values, error) {
	values := Values{}
	var first error
	for query != "" {
		part := query
		if index := indexByte(query, '&'); index >= 0 {
			part, query = query[:index], query[index + 1:]
		} else {
			query = ""
		}
		if part == "" {
			continue
		}
		if indexByte(part, ';') >= 0 {
			if first == nil {
				first = EscapeError("invalid semicolon separator in query")
			}
			continue
		}
		key, value := part, ""
		if index := indexByte(part, '='); index >= 0 {
			key, value = part[:index], part[index + 1:]
		}
		decodedKey, err := QueryUnescape(key)
		if err != nil {
			if first == nil {
				first = err
			}
			continue
		}
		decodedValue, err := QueryUnescape(value)
		if err != nil {
			if first == nil {
				first = err
			}
			continue
		}
		values[decodedKey] = append(values[decodedKey], decodedValue)
	}
	return values, first
}
